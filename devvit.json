{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "moatwatch",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "query1.finance.yahoo.com",
        "api.twelvedata.com",
        "api.tiingo.com",
        "alphavantage.co",
        "financialmodelingprep.com"
      ]
    },
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "moderator"
    }
  },
  "scheduler": {
    "tasks": {
      "intraday-pass": {
        "endpoint": "/internal/scheduler/daily-charts-pass",
        "cron": "0,5,10,15,20,25,30,35,40,45,50,55 13-21 * * 1-5",
        "data": { "marketHoursOnly": true }
      },
      "evening-pass": {
        "endpoint": "/internal/scheduler/daily-charts-pass",
        "cron": "30 21,23,1,3,5 * * 1-6",
        "data": {}
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Re-post latest session (force)",
        "description": "Republish the latest session even if already posted - creates a duplicate",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-force"
      }
    ]
  },
  "dev": {
    "subreddit": "TheMoat"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
